# 로컬 개발용 (infra/docker-compose.yml 기준). 실제 배포 환경 값은 별도 시크릿 매니저 사용.

DATABASE_URL=jdbc:postgresql://localhost:5432/siso
DATABASE_USER=siso
DATABASE_PASSWORD=siso_dev_only

# 크롤러(psycopg)는 JDBC가 아닌 libpq DSN 형식 사용
CRAWLER_DATABASE_URL=postgresql://siso:siso_dev_only@localhost:5432/siso

REDIS_URL=redis://localhost:6379

# frontend가 SSR 시 피드 API를 호출할 백엔드 주소 (서버 전용, 브라우저에 노출 안 됨)
BACKEND_API_URL=http://localhost:8080

# 관리자 CMS(/admin) 인증 — 백엔드(Basic Auth)와 프론트(proxy.ts 게이트 +
# 백엔드 호출용 헤더) 양쪽 프로세스 환경에 동일한 값으로 설정해야 함
ADMIN_USERNAME=admin
ADMIN_PASSWORD=local-dev-only-password

# 댓글/투표/신고/피드백 작성 시 X-Anon-Id 헤더가 진짜 그 쿠키를 가진 요청인지
# 증명하는 서명 비밀키 — 백엔드와 프론트(Server Action) 양쪽에 동일한 값으로
# 설정해야 함. 기본값을 두면 공개 레포에 그대로 커밋돼 서명 검증이 무의미해지므로
# 절대 기본값 두지 말 것(ADMIN_PASSWORD와 같은 이유). 로컬 개발용으로 아무 랜덤
# 문자열이나 넣고 시작하면 됨: openssl rand -hex 32
ANON_ID_SIGNING_SECRET=

# 플레이그라운드 주제 AI 합성(선택) — 비워두면 크롤러는 매칭까지만 수행하고
# 합성 단계는 건너뜀. openrouter.ai에서 발급.
OPENROUTER_API_KEY=
# 선택: 기본값은 openrouter/free(비용 최소화 우선 — 구조화 출력을
# 지원하는 무료 모델 중 자동 선택). 품질이 부족하면 특정 유료 모델
# 슬러그(예: anthropic/claude-haiku-4.5)로 명시적으로 지정할 것.
OPENROUTER_SYNTHESIS_MODEL=

# 국민청원 랭킹 위젯(선택) — 비워두면 동기화 배치가 매번 빈 목록만 받아서
# petitions 테이블이 채워지지 않음(위젯도 자연히 빈 채로 숨겨짐).
# open.assembly.go.kr에서 발급(열린국회정보 Open API).
ASSEMBLY_API_KEY=
# 선택: 청원 동기화 주기(ms). 기본 30분. 어드민 설정이 아니라 배포 시점
# 인프라 설정(크롤러 cron 주기와 같은 성격).
PETITION_SYNC_INTERVAL_MS=

# IP 해시 salt — 반드시 배포 환경마다 고유한 값으로 바꿀 것(dev 기본값
# 재사용 금지). 한번 정하면 바꾸지 말 것(바꾸면 기존에 저장된 해시와
# 대조가 끊김).
IP_HASH_SALT=local-dev-only-salt

# 신고 1차 분류 LLM 배치(D11, OpenRouter 경유) — 비워두면 배치가 스킵됨
# (에러 아님). 기본 분류 모델은 어드민 설정(moderation_settings)에서 변경 가능.
# OPENROUTER_API_KEY와 같은 키 재사용.
LLM_CLASSIFY_INTERVAL_MS=

# IP 해시 자동 파기 배치 주기(ms). 기본 24시간 — 7절 "90일 후 파기"
# 정책의 실행 주기일 뿐, 보유기간 자체(90일)는 코드 상수로 고정되어 있음.
RETENTION_PURGE_INTERVAL_MS=

# 뉴스레터('주간 좌우 리포트', D12) — resend.com에서 발급. 비워두면
# 구독/확인/수신거부 API는 정상 동작하지만 실제 메일 발송만 스킵됨(로그 경고).
RESEND_API_KEY=
# 실제 배포 시 Resend에 도메인 인증(SPF/DKIM) 후 그 도메인의 주소로
# 바꿀 것 — 비워두면 Resend 공용 발신주소(onboarding@resend.dev)로
# 발송되어 스팸함행 위험이 큼.
NEWSLETTER_FROM_ADDRESS=onboarding@resend.dev
# 뉴스레터 메일 본문의 링크(확인/수신거부) 생성에 쓰는 프론트 주소.
FRONTEND_URL=http://localhost:3000
# 선택: 발송 스케줄(cron). 기본 매주 월요일 09:00(KST).
NEWSLETTER_SEND_CRON=

# 프론트가 OG 이미지(next/og)·공유 링크 생성에 쓰는 실제 공개 도메인.
# 브라우저에 노출됨(NEXT_PUBLIC_ 접두사). next dev에서는 이 값이 OG
# 이미지에 반영되지 않는 Next.js 16 dev 모드 한정 이슈가 있음 — next
# build/prod에서만 정상 동작 확인됨.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# 애드센스 광고 슬롯 노출 여부. true가 아니면 광고 영역이 아예 렌더링
# 안 됨(placeholder도 안 보임). 애드센스 심사 승인 전까지는 반드시
# 비워두거나 false로 둘 것.
NEXT_PUBLIC_ADS_ENABLED=false

# 에러 모니터링(sentry.io에서 프로젝트 생성 후 DSN 발급, 백/프론트 공용
# 프로젝트로 하나만 만들어도 됨). 비워두면 Sentry SDK가 스스로
# 비활성화됨(공식 동작) — 계정 만들기 전까지는 조용히 꺼져 있음.
# 프론트는 브라우저에서도 초기화해야 해서 NEXT_PUBLIC_ 접두사 필요(DSN
# 자체는 공개돼도 되는 값 — 시크릿 아님).
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# 댓글 작성 시 reCAPTCHA v3 점수 기반 검증(§6). google.com/recaptcha/admin
# 에서 사이트 등록 후 사이트 키/보안 비밀키 발급. SECRET_KEY 비워두면
# 백엔드가 검증 자체를 스킵(에러 아님) — SITE_KEY도 비워두면 프론트가
# 스크립트를 아예 안 실어서 토큰 없이 그대로 제출됨.
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
# 선택: 0.0(봇)~1.0(사람) 중 통과 최소 점수. 기본 0.5.
RECAPTCHA_MIN_SCORE=
